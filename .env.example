# Copy to .env (git-ignored) or export in your shell. Never commit a real key.
# Vlipsy issues API keys on request: see https://docs.vlipsy.com and https://vlipsy.com/terms (API section).
VLIPSY_API_KEY=

# Optional
# AGENT_MEMES_LOCAL_DIRS=/path/to/my/clips:/another/folder
# AGENT_MEMES_SAFESEARCH=medium   # high | medium | low | off
# AGENT_MEMES_CACHE_DIR=~/.cache/agent-memes
# AGENT_MEMES_FONT=/path/to/Impact.ttf
